# ──────────────────────────────────────────────
# AutoPlanner AI — Environment Variables
# ──────────────────────────────────────────────
# Copy this file from .env.example and fill in your keys.
# NEVER commit this file to version control.
# ──────────────────────────────────────────────

# ── AI Provider ─────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyCZsPaniZM1eFDMbSTI9pi0y7fUttc8RsU

# ── Environment ─────────────────────────────────
# Options: dev | staging | prod
ENV=dev

# ── Feature Flags ───────────────────────────────
# Set to true to use a mock AI provider (no API calls)
USE_MOCK_AI=false

# Enable AI request/response logging
ENABLE_AI_LOGGING=true

# Enable token usage tracking
ENABLE_TOKEN_TRACKING=true

# Max tokens allowed per day (rate limiting)
MAX_TOKENS_PER_DAY=100000

# ── Firebase / Firestore ────────────────────────
FIRESTORE_PROJECT_ID=autoplanner-ai-dev
