# ──────────────────────────────────────────────
# AutoPlanner AI — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── AI Provider ─────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey)
# Optional — you can enter it in the app via Settings → AI Settings instead.
GEMINI_API_KEY=

# ── Environment ─────────────────────────────────
# Options: dev | staging | prod
ENV=dev

# ── Feature Flags ───────────────────────────────
# Set to true to use a mock AI provider (no API calls)
USE_MOCK_AI=false

# Enable AI request/response logging
ENABLE_AI_LOGGING=true

# Enable token usage tracking
ENABLE_TOKEN_TRACKING=true

# Max tokens allowed per day (rate limiting)
MAX_TOKENS_PER_DAY=100000

# ── Monitoring ─────────────────────────────────
# Optional Sentry DSN for remote crash reporting.
# Leave empty in local/dev builds to keep monitoring fully on-device.
SENTRY_DSN=

# ── Notes ──────────────────────────────────────
# Google Calendar sync uses end-user OAuth inside the app.
# No .env key is required for Google Calendar.
